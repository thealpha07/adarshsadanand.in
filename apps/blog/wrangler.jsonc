// Cloudflare Worker that serves this app's built files (no server code).
// Paths here are relative to this file. See docs/adr/0007-workers-static-assets.md.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "as-blog",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./dist",
    // Unknown paths (e.g. /post/my-slug) get index.html so React Router can handle them.
    "not_found_handling": "single-page-application"
  }
}
